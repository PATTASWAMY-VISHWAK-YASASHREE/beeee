{
  "name": "bee-bridge",
  "version": "0.1.0",
  "private": false,
  "description": "A read-only MCP server and Agent Skill that gives a coding agent the reasoning behind a decision from a Bee wearable, treating transcripts as untrusted third-party speech.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "src/bee-index.ts",
  "scripts": {
    "start": "tsx src/bee-index.ts",
    "dev": "tsx watch src/bee-index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:attack": "tsx scripts/demo.ts injection",
    "demo:secrets": "tsx scripts/demo.ts secrets"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bee",
    "wearable",
    "agent-skill",
    "prompt-injection"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
