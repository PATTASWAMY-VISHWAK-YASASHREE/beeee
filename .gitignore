node_modules/
dist/
*.log
.DS_Store
# Every env-file variant, not just the two common names. `.env.production` or
# `.env.staging` would otherwise be tracked silently, and this project reads real
# bearer tokens (BEE_BRIDGE_TOKEN, BEE_MCP_HTTP_TOKEN). Git history keeps a
# secret long after `git rm`, so the omission is expensive.
.env
.env.*
!.env.example
coverage/
.vitest/
# Root-anchored: an unscoped `data/` matches src/data or docs/data too, which
# would silently drop a real first-party directory or a checked-in fixture.
/data/
/*.sqlite
# Generated test state. Written by tests/durability.test.ts and normally removed
# in an afterAll hook - but a crash or Ctrl-C leaves it behind, and the next
# `git add -A` would commit runtime output.
.test-state-*/

# Scratch file used to pass a multi-line commit message to `git commit -F`.
# It kept being swept in by `git add -A` because it existed at the moment of
# staging, so it is ignored explicitly rather than left to chance.
cm.txt

# A synced Bee export is the user's own conversation data. It must never be
# committed, and this is the one .gitignore rule here that matters for safety
# rather than tidiness.
bee-data/
*.bee-sync.json

# Local TLS material for Wristbox. Never commit a private key or a pfx: a
# throwaway cert belongs in a temp directory, not in the repository.
*.pfx
*.pem
tmp-tls/
